<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Golden Circular Emblem Base -->
    <path
        android:pathData="M54,20 A34,34 0 1,0 54,88 A34,34 0 1,0 54,20 Z"
        android:strokeWidth="2.5"
        android:strokeColor="#FFD48B5D"
        android:fillColor="#338E4E28" />
    
    <!-- Stylized Fast Lightning Snatch Arrow -->
    <path
        android:pathData="M56,26 L38,54 L52,54 L48,82 L70,50 L56,50 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:angle="90"
                android:endColor="#FFE4A77C"
                android:startColor="#FFC67A48"
                android:type="linear" />
        </aapt:attr>
    </path>

    <!-- Download Tray Arc Indicator -->
    <path
        android:pathData="M39,78 L69,78"
        android:strokeWidth="3.5"
        android:strokeLineCap="round"
        android:strokeColor="#FFE4A77C" />
</vector>
